# Copy this file to .env.local and fill in your Supabase project's values.
# Without these, the public site still works fully using example data, but
# the admin panel cannot log in or save changes — see README.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the deployed site (used for metadata, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed locally if you want to run a seeding script with elevated
# privileges. Never expose this in the browser or commit it.
# SUPABASE_SERVICE_ROLE_KEY=
